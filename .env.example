# OpenRouter only — one key for chat + Whisper
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4

# Whisper on OpenRouter (inherits LLM_API_KEY / LLM_BASE_URL if left blank)
# WHISPER_API_KEY=
# WHISPER_BASE_URL=https://openrouter.ai/api/v1
WHISPER_MODEL=openai/whisper-large-v3

# Optional OpenRouter headers
# LLM_HTTP_REFERER=http://localhost:3847
# LLM_APP_NAME=Stitch
